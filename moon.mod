name = "noweizongqing/dtbscope"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/noweizongqing/dtbscope"

license = "Apache-2.0"

keywords = [ "devicetree", "dtb", "dts", "fdt", "embedded" ]

preferred_target = "wasm-gc"

description = "Device tree compiler and inspector in pure MoonBit: DTS to DTB, DTB back to DTS, and overlay application, with no dtc binary present."

import {
  "moonbitlang/x@0.5.7",
}
